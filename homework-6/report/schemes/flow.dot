digraph F {
  rankdir=TB; dpi=200; bgcolor="white"; nodesep=0.35; ranksep=0.32;
  node [fontname="Liberation Serif", fontsize=12, shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#555555", width=3.2];
  edge [fontname="Liberation Serif", fontsize=11, color="#444444"];
  start [label="Начало (окно обновления)", shape=oval, fillcolor="#E3EEF9"];
  m [label="1. Манифест сервера,\nвыбор релиза для кольца АРМ"];
  d1 [label="Есть новый релиз\nдля кольца?", shape=diamond, fillcolor="#FFF2CC"];
  dl [label="2. Загрузка пакета (3 попытки)"];
  d2 [label="3. SHA-256 пакета\nсовпадает?", shape=diamond, fillcolor="#FFF2CC"];
  ab [label="Прерывание, изменений нет\n(код 3)", fillcolor="#F8D7D7"];
  bk [label="4–5. Снимок данных и резервная копия\nappsettings.json, кэш, SQLite + SHA-256"];
  ins [label="6–7. Установка в неактивный слот,\nпроверка файлов, миграции БД"];
  d3 [label="Установка\nуспешна?", shape=diamond, fillcolor="#FFF2CC"];
  sw [label="8. Переключение слота Blue-Green"];
  hc [label="9. Health Check:\nцелостность → БД → API → считыватель\n(latency каждой проверки)"];
  d4 [label="Критичные проверки\nпройдены?", shape=diamond, fillcolor="#FFF2CC"];
  ok [label="10. Акт «ГОТОВ» (код 0)", fillcolor="#D9EAD3"];
  rb [label="Откат: слот назад, восстановление\nданных из копии, очистка слота,\nповторный Health Check", fillcolor="#F8D7D7"];
  act2 [label="Акт «НЕ ГОТОВ, выполнен откат» (код 2)", fillcolor="#F8D7D7"];
  end [label="Конец", shape=oval, fillcolor="#E3EEF9"];
  start -> m -> d1;
  d1 -> dl [label="да"]; d1 -> end [label="нет"];
  dl -> d2; d2 -> bk [label="да"]; d2 -> ab [label="нет"]; ab -> end;
  bk -> ins -> d3; d3 -> sw [label="да"]; d3 -> rb [label="нет"];
  sw -> hc -> d4; d4 -> ok [label="да"]; d4 -> rb [label="нет"];
  rb -> act2 -> end; ok -> end;
}
